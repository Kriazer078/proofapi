# memory = local simulation of the Solana program; anchor = real program on devnet
CHAIN_MODE=memory
ISSUER_NAME="ProofAPI Demo"
DATABASE_URL="file:./dev.db"

# --- CHAIN_MODE=anchor (filled by npm run setup and the deploy steps) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
PROGRAM_ID=
AUTHORITY_PUBKEY=
WRITER_KEYPAIR_PATH=.keys/writer.json
AUTHORITY_KEYPAIR_PATH=.keys/authority.json

# --- Hosted deployment (Vercel). Set these in Vercel → Project → Settings → Environment Variables. ---
# WRITER_SECRET_KEY: the writer keypair as a JSON array (contents of .keys/writer.json). Mark it Sensitive.
# DATABASE_URL / DATABASE_URL_UNPOOLED: added automatically by the Neon integration.
# IP_HASH_SALT: any long random string; IPs are stored only as salted hashes.
# RATE_LIMIT_PER_HOUR=10  RATE_LIMIT_PER_DAY=200  (each certificate costs about 0.0025 SOL)
