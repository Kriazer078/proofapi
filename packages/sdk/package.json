{
  "name": "proofapi",
  "version": "0.1.0",
  "description": "TypeScript client for sealing and verifying AI results with ProofAPI",
  "keywords": [
    "ai",
    "audit",
    "proof",
    "solana",
    "verification",
    "llm",
    "agents"
  ],
  "homepage": "https://proofapi.vercel.app/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kriazer078/proofapi.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
