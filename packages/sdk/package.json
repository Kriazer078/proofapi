{
  "name": "proofapi",
  "version": "0.2.0",
  "description": "Seal and verify AI answers on Solana with ProofAPI. TypeScript client and MCP server for AI agents.",
  "keywords": [
    "agents",
    "ai",
    "audit",
    "llm",
    "mcp",
    "model-context-protocol",
    "proof",
    "solana",
    "verification"
  ],
  "homepage": "https://proofapi.vercel.app/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kriazer078/proofapi.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "proofapi-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
